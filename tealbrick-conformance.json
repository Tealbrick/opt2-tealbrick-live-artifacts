{
  "waivers": [
    {
      "id": "A9",
      "until": "0.1.20",
      "reason": "A9 admits only the publicRoutes purposes oauth_callback and webhook (conformance 0.1.18 source); it pre-dates purpose viewer (spec 0.1.43, MANIFEST M-PR-2). The viewer route is served only on the views origin (tb-views), never on this app's own address. Remove when conformance admits purpose viewer."
    }
  ],
  "setup": [
    {
      "id": "page_a",
      "as": "agentA",
      "op": "artifact_create",
      "input": {
        "title": "Conformance page",
        "view": {
          "html": "<!doctype html><h1>Conformance</h1>"
        },
        "contract": {
          "v": 1,
          "inputs": [
            {
              "key": "n",
              "kind": "push"
            }
          ]
        }
      },
      "capture": {
        "pageA": "/id"
      }
    },
    {
      "id": "page_a_seen",
      "as": "agentA",
      "op": "artifact_get",
      "input": {
        "id": "${pageA}"
      },
      "capture": {
        "shaA": "/version/sha256",
        "verA": "/version/n"
      }
    }
  ],
  "inputs": {
    "artifact_create": {
      "title": "Conformance page",
      "view": {
        "html": "<!doctype html><h1>Conformance</h1>"
      }
    },
    "artifact_get": {
      "id": "${pageA}"
    },
    "artifact_update": {
      "id": "${pageA}",
      "title": "Conformance page (renamed)"
    },
    "artifact_delete": {
      "id": "${pageA}"
    },
    "artifact_data_put": {
      "id": "${pageA}",
      "key": "n",
      "data": {
        "total": 1
      }
    },
    "artifact_refresh": {
      "id": "${pageA}"
    },
    "artifact_share": {
      "id": "${pageA}",
      "label": "Conformance link",
      "expiresInDays": 7,
      "expect": {
        "version": "${verA}",
        "htmlSha256": "${shaA}",
        "title": "Conformance page"
      }
    },
    "artifact_publish": {
      "id": "${pageA}",
      "version": 1,
      "data": [],
      "expect": {
        "htmlSha256": "${shaA}"
      }
    },
    "artifact_link_revoke": {
      "linkId": "lnk_00000000000000000000000000"
    }
  }
}
